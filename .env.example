# Copy to .env and tweak. docker compose reads .env automatically.

# Bind-only-localhost by default; flip to 0.0.0.0 to expose on LAN/Tailscale.
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# Filename inside ./models (the bind-mount). Swap to a different GGUF freely.
MODEL_FILE=Qwen3-Coder-30B-A3B-Instruct-Q8_0.gguf

# Name OpenCode will see in GET /v1/models. Keep stable so opencode.json doesn't drift.
MODEL_ALIAS=qwen3-coder

# Context tokens. 65536 is a safe starting point for 30B-A3B on Strix Halo.
# Push to 131072 once you've confirmed it doesn't OOM under load.
CTX_SIZE=65536
